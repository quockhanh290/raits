# RAITS Project .gitignore
# Prevents committing sensitive data, large files, and temporary files

# ============================================
# Virtual Environments
# ============================================
venv/
env/
ENV/
.venv/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================
# Data Files (CRITICAL - Large files)
# ============================================
# Raw data from Polygon.io
raits/data/raw/
raits/data/cache/
raits/data/processed/*.parquet
raits/data/processed/*.csv
raits/data/processed/*.h5

# Specific large file formats
*.csv
*.parquet
*.h5
*.hdf5
*.feather

# Exception: committed baselines (survive cache wipe)
!baselines/
!baselines/*.csv
!baselines/*.json

# ============================================
# Logs
# ============================================
raits/logs/
*.log
logs/

# ============================================
# Backtest Results
# ============================================
raits/results/
results/
*.html
*.pdf

# ============================================
# Jupyter Notebooks
# ============================================
.ipynb_checkpoints/
*.ipynb
notebooks/*.ipynb

# ============================================
# IDEs and Editors
# ============================================
# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#

# ============================================
# Operating System
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.Trash-*

# ============================================
# API Keys and Secrets (CRITICAL!)
# ============================================
.env
.env.local
.env.*.local
secrets.py
config_private.py

*.key
*.pem
credentials.json

# ============================================
# Testing
# ============================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# ============================================
# Profiling
# ============================================
*.prof
*.lprof

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.bak
*.backup

# ============================================
# Model Checkpoints (if using ML models)
# ============================================
models/checkpoints/
*.pkl
*.pickle
*.joblib

# ============================================
# Documentation Build
# ============================================
docs/_build/
docs/_static/
docs/_templates/

# ============================================
# Specific to RAITS
# ============================================
# Vault test results (keep only summary, not full data)
vault_test_results/
wfo_results/

# Backtest cache files
*.backtest_cache

# ============================================
# Live runtime state (changes every session)
# ============================================
live_positions.json
global_index/live_state_data.js
global_index/preflight_state.json
global_index/maxhold_state.json
global_index/replay_checkpoint.json
# Dữ liệu runtime, cùng loại với các file trạng thái ở trên: đổi mỗi phiên nên
# theo dõi trong git chỉ tạo nhiễu, và một bản commit hôm nay là bản SAI vào ngày mai.
# live_history.py ghi mỗi lần khớp lệnh
trade_log.jsonl
# runner.py ghi cạnh file vị thế (trượt giá tích luỹ)
slip_stats.json
bao_cao_*.txt
global_index/paper_history.json
# p0c_overnight.py capture output — megabytes of run log, not source
p0c_signals_*.txt
monitor/inputs/ibkr_flex/

# ============================================
# Parquet data cache (2.3GB — rebuild from Polygon/Databento, never commit)
# ============================================
data/
global_index/data/

# ============================================
# Throwaway run artefacts — 6.7 MB of these had accumulated by 2026-08-15,
# enough to bury the real entries in `git status`. All regenerable.
# ============================================
# Dashboard verification screenshots
tmp_*.png
raitstmp_*.png
# Test-run output captured to a file rather than read from the terminal
pb_*.txt
opfix_final*.txt
full_suite*.txt
scoped_suite.txt
# run_live_day writes one of these per day, and paper_evidence_reader SCANS them:
# a throwaway --dry-run left a log line here that added a B3 episode and broke
# test_per_file_log_scan_reproduces_the_single_pass_numbers. Ignoring them keeps
# them out of git, but note they still affect that gate — delete after any
# ad-hoc run rather than leaving them behind.
live_day_*.log

# The `*.html` rule above is for exported backtest reports. The dashboards are
# source: their pages were tracked before that rule existed, so new ones were
# being skipped in silence — a commit could add a whole route's CSS and JS and
# leave the page itself behind. Added 2026-08-17 after /realtime-next shipped
# without its index.html.
!global_index/dash/**/*.html
!global_index/dash/*.html
